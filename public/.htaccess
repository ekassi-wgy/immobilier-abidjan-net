# Racine publique du site (DocumentRoot en production sur Plesk)

Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fichiers cachés (.env, .git…) : accès interdit
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Fichier existant : servi tel quel (CSS, JS, images, polices)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Tout le reste passe par le front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# En-têtes de sécurité de base
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression : le HTML, le CSS, le JS et le SVG partent en gzip (≈ 25 Ko au lieu de 172 Ko
# pour app.css). WebP, woff2 et PDF sont déjà compressés : les repasser en gzip ne gagne rien.
# Module absent en local (MAMP) : la directive reste sans effet, Plesk le fournit.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache navigateur des ressources statiques. Les URL des CSS/JS portent déjà `?v={date de
# modification}` (helpers `asset()` et `cmsadmin_asset()`) et les fichiers envoyés ont un nom
# aléatoire jamais réécrit : un an de cache est sans risque, le contenu d'une URL ne change pas.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|woff2|webp|jpe?g|png|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
