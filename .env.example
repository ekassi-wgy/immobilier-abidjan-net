# Copier en .env (jamais commité) puis adapter à l'environnement.

# local | staging | production
APP_ENV=local
# Détail des erreurs à l'écran (ignoré en production)
APP_DEBUG=true
APP_URL=http://localhost:8888
# Préfixe d'URL si le site n'est pas servi à la racine du domaine (vide sinon)
APP_BASE_PATH=
APP_LOCALE=fr
# Prévisualisation avec données fictives (/, /styleguide, /cmsadmin…) : n'est active qu'en APP_ENV=local
APP_PREVIEW=true

DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=immobilier_abidjan_net
DB_USERNAME=root
DB_PASSWORD=root

# Cache des sites/domaines/paramètres en secondes (vide = désactivé, conseillé en local ; 600 en production)
CACHE_SITES_TTL=

# auto (HTTPS détecté) | true | false
SESSION_SECURE=auto
SESSION_LIFETIME=120

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@immobilier.abidjan.net
MAIL_FROM_NAME="immobilier.abidjan.net"
